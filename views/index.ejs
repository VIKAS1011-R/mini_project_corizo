<!DOCTYPE html>
<html lang="en">

<head>
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <style>
        .main_edit {
            background: wheat;
            width: 50%;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
    </style>
</head>

<body>

    <div class="container">
        <div style="margin-top: 2rem;margin-bottom: 2rem; justify-content: center; align-content: center">
            <div class="main_edit">
                <h4>Student Registration</h4>
                <form action="/save" method="post">
                    <div>
                        <label for="rollNo">Roll No:</label>
                        <input type="text" name="rollNo" id="rollNo" class="form-control" required>
                    </div>
                    <div>
                        <label for="name">Name:</label>
                        <input type="text" name="name" id="name" class="form-control">
                    </div>
                    <div>
                        <label for="Degree">Degree:</label>
                        <input type="text" name="degree" id="degree" class="form-control">
                    </div>
                    <div>
                        <label for="City">City:</label>
                        <input type="text" name="city" id="city" class="form-control">
                    </div>
                    <div class="my-3">
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
        <h5  class=" border-bottom border-top border-3 w-100 " style="display:flex; justify-content: center;"><span class="fs-2 fw-bold">Student Table</span></h5>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Roll No</th>
                    <th>Name</th>
                    <th>Degree</th>
                    <th>City</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% students.forEach((student)=> { %>
                    <tr>
                        <td>
                            <%= student.rollNo %>
                        </td>
                        <td>
                            <%= student.name %>
                        </td>
                        <td>
                            <%= student.degree %>
                        </td>
                        <td>
                            <%= student.city %>
                        </td>
                        <td>
                            <a href="/edit/<%= student.rollNo %>" class="btn btn-primary">Edit</a>
                            <a href="/delete/<%= student.rollNo %>" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
        </div>
    </div>
</body>

</html>