<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Document</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <style>
        body {
            background: linear-gradient(to bottom right, purple 45%, blue);
        }
        .main_edit {
            background: wheat;
            width: 50%;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
    </style>
  </head>
  <body>
    <div
      class="container"
      style="height: 100vh; justify-content: center; align-content: center"
    >
      <div class="main_edit">
        <h4>Update Student Details</h4>
        <form action="/edit/<%= student.id %>" method="post">
          <div>
            <label for="rollNo">Roll No:</label>
            <input
              type="text"
              name="rollNo"
              id="rollNo"
              class="form-control"
              value="<%= student.rollNo %>"
              autofocus onfocus="this.setSelectionRange(0, this.value.length);"
            />
          </div>
          <div>
            <label for="name">Name:</label>
            <input type="text" name="name" id="name" class="form-control"
            value="<%= student.name %>"" />
          </div>
          <div>
            <label for="Degree">Degree:</label>
            <input
              type="text"
              name="degree"
              id="degree"
              class="form-control"
              value="<%= student.degree %>"
            />
          </div>
          <div>
            <label for="City">City:</label>
            <input
              type="text"
              name="city"
              id="city"
              class="form-control"
              value="<%= student.city %> "
            />
          </div>
          <div class="my-3">
            <button type="submit"  class="btn btn-primary">Save</button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
